<section class="omil-banner">

  <!-- Top Bar -->
  <div class="omil-banner__top">
    <div class="omil-logo">
      {{ section.settings.logo_text }}
    </div>

    <div class="omil-top-message">
      {{ section.settings.top_message }}
    </div>

    <a href="{{ section.settings.top_button_link }}" class="omil-top-btn">
      {{ section.settings.top_button_text }} →
    </a>
  </div>

  <!-- Main Content -->
  <div class="omil-banner__content">
    <h1 class="omil-banner__heading">
      {{ section.settings.heading }}
    </h1>

    <p class="omil-banner__description">
      {{ section.settings.description }}
    </p>

    <a href="{{ section.settings.button_link }}" class="omil-main-btn">
      {{ section.settings.button_text }} →
    </a>
  </div>

  <!-- Bottom Strip -->
  <div class="omil-banner__bottom">
    {{ section.settings.bottom_text }}
  </div>

</section>

<style>
/* ===== BANNER WRAPPER ===== */
.omil-banner {
  background: #f5f5f5;
  background-image: url({{ section.settings.background_image | image_url }});
  background-size: cover;
  background-position: center;
  padding: 30px 40px 60px;
  position: relative;
  font-family: Arial, sans-serif;
}

/* ===== TOP BAR ===== */
.omil-banner__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 80px;
}

.omil-logo {
  font-weight: bold;
  font-size: 20px;
  letter-spacing: 1px;
}

.omil-top-message {
  font-size: 14px;
  border: 2px solid red;
  padding: 6px 12px;
}

.omil-top-btn {
  background: #ffe600;
  padding: 10px 18px;
  text-decoration: none;
  font-weight: 600;
  color: #000;
  transition: all 0.3s ease;
}

.omil-top-btn:hover {
  transform: translateY(-3px);
}

/* ===== MAIN CONTENT ===== */
.omil-banner__content {
  max-width: 500px;
}

.omil-banner__heading {
  font-size: 56px;
  font-weight: 700;
  margin-bottom: 20px;
}

.omil-banner__description {
  font-size: 16px;
  margin-bottom: 30px;
  line-height: 1.6;
  border: 2px solid red;
  padding: 10px;
}

.omil-main-btn {
  background: #000;
  color: #fff;
  padding: 14px 30px;
  text-decoration: none;
  display: inline-block;
  transition: all 0.3s ease;
}

.omil-main-btn:hover {
  transform: translateY(-4px);
}

/* ===== BOTTOM STRIP ===== */
.omil-banner__bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #eaeaea;
  text-align: center;
  padding: 10px;
  font-size: 13px;
  border: 2px solid red;
}

/* ===== MOBILE ===== */
@media (max-width: 768px) {

  .omil-banner {
    padding: 20px;
  }

  .omil-banner__top {
    flex-direction: column;
    gap: 15px;
    text-align: center;
  }

  .omil-banner__heading {
    font-size: 36px;
  }

  .omil-banner__content {
    max-width: 100%;
  }
}
</style>

{% schema %}
{
  "name": "Omil Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "TISSO VISION"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top Button Link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Main Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Main Button Link"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Strip Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Omil Banner"
    }
  ]
}
{% endschema %}
